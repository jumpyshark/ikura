+    paths.forEach { path ->
+      val file=File(Uri.parse(path).path ?: "")
+      if(file.name.startsWith("receipt-review-") && file.parentFile?.canonicalFile==context.cacheDir.canonicalFile) file.delete()
+    }
+  }
