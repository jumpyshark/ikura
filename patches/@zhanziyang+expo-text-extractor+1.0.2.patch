+import UIKit
+import CoreImage
+import ImageIO
+
+enum ReceiptImageReview {
+    static func localURL(_ uri: String) throws -> URL {
+        if uri.hasPrefix("/") { return URL(fileURLWithPath: uri) }
+        if let url = URL(string: uri), url.isFileURL { return url }
+        throw NSError(domain: "ReceiptLog", code: 1, userInfo: [NSLocalizedDescriptionKey: "画像を開けません。もう一度選択してください。"])
+    }
+
+    static func write(_ image: UIImage) throws -> String {
+        let url = FileManager.default.temporaryDirectory.appendingPathComponent("receipt-review-\(UUID().uuidString).jpg")
+        guard let data = image.jpegData(compressionQuality: 0.98) else { throw NSError(domain: "ReceiptLog", code: 2) }
+        try data.write(to: url, options: .atomic)
+        return url.absoluteString
+    }
+
+    static func prepare(_ uri: String, rotation: Int) throws -> [String: Any] {
+        let url = try localURL(uri)
+        guard let source = CGImageSourceCreateWithURL(url as CFURL, nil),
+              let cg = CGImageSourceCreateThumbnailAtIndex(source, 0, [
+                kCGImageSourceCreateThumbnailFromImageAlways: true,
+                kCGImageSourceCreateThumbnailWithTransform: true,
+                kCGImageSourceThumbnailMaxPixelSize: 2600
+              ] as CFDictionary) else { throw NSError(domain: "ReceiptLog", code: 3) }
+        let turns = ((rotation % 4) + 4) % 4
+        let width = turns % 2 == 0 ? cg.width : cg.height
+        let height = turns % 2 == 0 ? cg.height : cg.width
+        let format = UIGraphicsImageRendererFormat(); format.scale = 1; format.opaque = true
+        let image = UIGraphicsImageRenderer(size: CGSize(width: CGFloat(width), height: CGFloat(height)), format: format).image { ctx in
+            ctx.cgContext.translateBy(x: CGFloat(width) / 2, y: CGFloat(height) / 2)
+            ctx.cgContext.rotate(by: CGFloat(turns) * .pi / 2)
+            UIImage(cgImage: cg).draw(in: CGRect(x: -CGFloat(cg.width)/2, y: -CGFloat(cg.height)/2, width: CGFloat(cg.width), height: CGFloat(cg.height)))
+        }
+        let tw = max(1, Int(Double(width) * 160 / Double(max(width,height))))
+        let th = max(1, Int(Double(height) * 160 / Double(max(width,height))))
+        var pixels = [UInt8](repeating: 255, count: tw * th)
+        let drawn = pixels.withUnsafeMutableBytes { buffer -> Bool in
+            guard let context = CGContext(data: buffer.baseAddress, width: tw, height: th, bitsPerComponent: 8, bytesPerRow: tw, space: CGColorSpaceCreateDeviceGray(), bitmapInfo: CGImageAlphaInfo.none.rawValue), let normalized = image.cgImage else { return false }
+            context.draw(normalized, in: CGRect(x: 0, y: 0, width: CGFloat(tw), height: CGFloat(th)))
+            return true
+        }
+        guard drawn else { throw NSError(domain: "ReceiptLog", code: 4) }
+        return ["uri": try write(image), "width": width, "height": height, "pixels": pixels.map { Int($0) }, "thumbnailWidth": tw, "thumbnailHeight": th]
+    }
+
+    static func render(_ uri: String, crop: [Double], filter: String) throws -> String {
+        guard crop.count == 4, crop.allSatisfy({ $0.isFinite }), crop[0] >= 0, crop[1] >= 0, crop[2] > 0, crop[3] > 0, crop[0]+crop[2] <= 1.00001, crop[1]+crop[3] <= 1.00001,
+              let image = UIImage(contentsOfFile: try localURL(uri).path)?.cgImage else { throw NSError(domain: "ReceiptLog", code: 5) }
+        let rect = CGRect(x: crop[0]*Double(image.width), y: crop[1]*Double(image.height), width: crop[2]*Double(image.width), height: crop[3]*Double(image.height)).integral.intersection(CGRect(x: 0, y: 0, width: CGFloat(image.width), height: CGFloat(image.height)))
