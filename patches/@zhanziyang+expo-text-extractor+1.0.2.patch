+            kCIInputContrastKey: filter == "mono" ? 1.4 : 1.12,
+            kCIInputBrightnessKey: 0.02
+        ])
+        guard let result = CIContext().createCGImage(output, from: input.extent) else { throw NSError(domain: "ReceiptLog", code: 7) }
+        return try write(UIImage(cgImage: result))
+    }
+
+    static func remove(_ uris: [String]) {
+        for uri in uris {
+            guard let url = try? localURL(uri), url.lastPathComponent.hasPrefix("receipt-review-"),
+                  url.deletingLastPathComponent().standardizedFileURL == FileManager.default.temporaryDirectory.standardizedFileURL else { continue }
