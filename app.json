{
  "expo": {
    "name": "ReceiptLog",
    "slug": "receiptlog",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jumpyshark.receiptlog",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ja",
        "CFBundleLocalizations": ["ja"]
      }
    },
    "android": {
      "package": "com.jumpyshark.receiptlog"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      ["expo-camera", {
        "cameraPermission": "レシートを撮影するためにカメラを使用します。",
        "recordAudioAndroid": false,
        "microphonePermission": false,
        "barcodeScannerEnabled": false
      }],
      [
        "expo-image-picker",
        {
          "photosPermission": "レシートや決済履歴の画像を読み込むために写真へのアクセスを使用します。",
          "cameraPermission": "レシートを撮影するためにカメラを使用します。"
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
